<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4FC3F7"/><corners android:radius="8dp"/>
            <stroke android:width="3dp" android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#0288D1"/><corners android:radius="8dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#2A2F36"/><corners android:radius="8dp"/></shape>
    </item>
</selector>
